{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "channelMessageId": {
      "type": "string"
    },
    "conversation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Direct",
            "Group",
            "Channel"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        },
        "isSelf": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "isMe": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Image",
              "Video",
              "Audio",
              "Voice",
              "File",
              "Sticker",
              "Location",
              "Contact",
              "Other"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "mime": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": [
              "string",
              "integer",
              "null"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          },
          "channelRef": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "contentEncoding": "base64"
          }
        },
        "required": [
          "kind",
          "channelRef"
        ]
      }
    },
    "replyTo": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "channelMessageId": {
          "type": "string"
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "channelMessageId"
      ]
    },
    "replyHandle": {
      "type": "string"
    },
    "raw": true
  },
  "required": [
    "id",
    "channel",
    "channelMessageId",
    "conversation",
    "author",
    "timestamp",
    "replyHandle",
    "raw"
  ]
}
