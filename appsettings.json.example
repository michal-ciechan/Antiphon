{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=17280;Database=antiphon;Username=antiphon;Password=antiphon_dev"
  },
  "Git": {
    "WorkspacePath": "",
    "DefaultBranch": "master",
    "PollIntervalSeconds": 30,
    "WorktreeBasePath": "C:\\Antiphon\\worktrees",
    "WorktreeStaleAfterDays": 7,
    "WorktreeJanitorIntervalHours": 24
  },
  "Llm": {
    "DefaultProvider": "openai",
    "DefaultModel": "claude-sonnet-4-6",
    "Providers": {
      "openai": {
        "ApiKey": "",
        "BaseUrl": "https://api.openai.com",
        "Models": ["gpt-5.2", "gpt-4o", "gpt-4o-mini", "o3", "o4-mini"]
      },
      "anthropic": {
        "ApiKey": "",
        "BaseUrl": "https://api.anthropic.com",
        "Models": ["claude-opus-4-6", "claude-sonnet-4-6", "claude-haiku-4-5-20251001"]
      }
    }
  },
  "SignalR": {
    "HubPath": "/hubs/workflow",
    "ReconnectIntervalsMs": [0, 2000, 5000, 10000, 30000],
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutSeconds": 30
  },
  "Audit": {
    "RetentionDays": 90,
    "EnableFullContent": true,
    "EnableIpLogging": true
  },
  "GitHub": {
    "Enabled": false,
    "PersonalAccessToken": "",
    "BaseUrl": "https://api.github.com"
  },
  "SessionRunner": {
    "BaseUrl": "http://localhost:17204",
    "Enabled": true,
    "EventReconnectDelayMs": 1000,
    "RequestTimeoutSeconds": 100,
    "EventStreamIdleTimeoutSeconds": 90
  },
  "Agents": {
    "DefaultDefinition": "claude",
    "Definitions": {
      "claude": {
        "Kind": "ClaudeCode",
        "Exe": "claude.exe",
        "ArgsTemplate": ["--dangerously-skip-permissions"],
        "Env": {}
      },
      "codex": {
        "Kind": "Codex",
        "Exe": "codex.cmd",
        "ArgsTemplate": ["--no-alt-screen", "--dangerously-bypass-approvals-and-sandbox"],
        "Env": {}
      },
      "raw-pwsh": {
        "Kind": "Raw",
        "Exe": "pwsh.exe",
        "ArgsTemplate": ["-NoLogo", "-NoProfile"],
        "Env": {}
      },
      "grok": {
        "Kind": "Grok",
        "Exe": "grok.exe",
        "ArgsTemplate": ["--always-approve", "--no-alt-screen"],
        "Env": {}
      }
    },
    "ClaudeReadyQuietPeriodMs": 5000,
    "ClaudeReadyMaxWaitMs": 60000,
    "ClaudeDoneMaxWaitMs": 300000,
    "CodexReadyQuietPeriodMs": 1000,
    "CodexReadyMaxWaitMs": 60000,
    "CodexDoneQuietPeriodMs": 3000,
    "CodexDoneMaxWaitMs": 300000,
    "GrokReadyQuietPeriodMs": 1000,
    "GrokReadyMaxWaitMs": 60000,
    "GrokReadyMinTotalWaitMs": 2000,
    "GrokDoneQuietPeriodMs": 3000,
    "GrokDoneMaxWaitMs": 300000
  },
  "AgentSessions": {
    "SessionLogPath": "logs/sessions"
  },
  "AgentTui": {
    "ProbeTimeoutSeconds": 30,
    "MaxProbeOutputBytes": 65536,
    "KeyRingPath": "",
    "KeyProtection": {
      "Mode": "Auto",
      "CertificatePath": "",
      "CertificatePrivateKeyPath": "",
      "CertificateThumbprint": "",
      "CertificateStoreName": "My",
      "CertificateStoreLocation": "CurrentUser"
    }
  },
  "SessionReconciliation": {
    "Enabled": true,
    "IntervalMs": 15000,
    "StartingGraceMs": 90000,
    "AgentGraceMs": 120000
  },
  "ContextWindow": {
    "DefaultContextTokens": 200000,
    "ModelOverrides": {}
  },
  "Retention": {
    "TranscriptRetentionDays": 30,
    "QueuedMessageRetentionDays": 30,
    "SessionRetentionDays": 90,
    "TaskRetentionDays": 180,
    "SweepHours": 6
  },
  "ContextCompaction": {
    "Enabled": true,
    "IdleMinutes": 480,
    "ContextPercent": 50,
    "CooldownHours": 24,
    "BoundaryTimeoutMinutes": 10
  },
  "Delegation": {
    "MaxCostUsdPerRoot": 200.00,
    "CheckInterpreterWorkingDirectory": "C:\\logs\\antiphon\\check-interpreter",
    "DiagnoseWorkingDirectory": "C:\\logs\\antiphon\\diagnose",
    "DiagnoseLabelMode": "Shadow"
  },
  "ChannelBridge": {
    "Enabled": false,
    "AgentStartTimeoutSeconds": 90,
    "AgentReadyDelaySeconds": 12,
    "MaxReplyChars": 4000,
    "PendingReplyTtlMinutes": 30,
    "DebounceWindowMs": 500,
    "DebounceMaxMs": 2000,
    "BatchingEnabled": true
  },
  "AntiphonMessaging": {
    "BootstrapServers": "localhost:19092",
    "InboundTopic": "channels.inbound",
    "OutboundTopic": "channels.outbound",
    "ConsumerGroup": "antiphon-server-bridge"
  },
  "Serilog": {
    "LogPath": "logs",
    "FileSizeLimitMb": 100,
    "RetainedFileCountLimit": 14,
    "RetainedFileTimeLimitDays": 5,
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Antiphon": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
