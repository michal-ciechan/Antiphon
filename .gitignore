/\[\]

# Alternate build output dirs used while daemons lock bin/ (see CLAUDE.md gotchas).
# Deliberately a wildcard: this was an enumerated list of one-off names, and the first
# --property:OutputPath=bin-orch/ that nobody had thought of got committed by a git add -A.
bin-*/

# TUnit's isolated build/test runs can leave disposable per-project temp output directories.
**/.tmp/

# Agent briefs and retained reports. Do not scratch-clean .antiphon/reports/ while
# task rows reference it; canonical reports survive delegate worktree cleanup.
.antiphon/

# pts-vibe-coding (managed by /pts-vibe-init)
.pts-vibe/state.json
.pts-vibe/implementation.json
.pts-vibe/memsearch/

