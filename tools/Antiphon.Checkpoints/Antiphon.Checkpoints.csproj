<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CheckpointBootstrap.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antiphon.Checkpoints</RootNamespace>
    <AssemblyName>Antiphon.Checkpoints</AssemblyName>
    <Version>1.0.0</Version>
    <RollForward>Major</RollForward>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>antiphon-checkpoints</ToolCommandName>
    <PackageId>Antiphon.Checkpoints</PackageId>
    <Description>Runs a plan's ### Checkpoints table: one command, one wait, one report.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="BuildPlacementGraph.proj" LogicalName="Antiphon.Checkpoints.BuildPlacementGraph.proj" />
    <Compile Include="../../scripts/lib/BuildDriverEnvironment.cs" Link="BuildDriverEnvironment.cs" />
    <Compile Include="../../scripts/lib/LeaseTempDirectory.cs" Link="LeaseTempDirectory.cs" />
    <Compile Include="../../scripts/lib/PhaseJournalDiagnostic.cs" Link="PhaseJournalDiagnostic.cs" />
    <!-- CARD-1793: the tool's ProcessDriver .ps1 shims start pwsh; give them a process-private cache. -->
    <Compile Include="../../src/Antiphon.Hosting/PwshPrivateCache.cs" Link="PwshPrivateCache.cs" />
    <ProjectReference Include="../../src/Antiphon.HostCleanup/Antiphon.HostCleanup.csproj" />
    <!-- Source identity (SourceSnapshot) reads the checkout with libgit2 instead of eleven git processes. -->
    <ProjectReference Include="../../src/Antiphon.GitInProcess/Antiphon.GitInProcess.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
