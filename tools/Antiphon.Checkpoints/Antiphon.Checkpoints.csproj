<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antiphon.Checkpoints</RootNamespace>
    <AssemblyName>Antiphon.Checkpoints</AssemblyName>
    <Version>1.0.0</Version>
    <RollForward>Major</RollForward>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>antiphon-checkpoints</ToolCommandName>
    <PackageId>Antiphon.Checkpoints</PackageId>
    <Description>Runs a plan's ### Checkpoints table: one command, one wait, one report.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
