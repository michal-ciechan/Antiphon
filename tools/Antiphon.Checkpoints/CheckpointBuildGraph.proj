<Project>
  <UsingTask TaskName="WalkCheckpointGraph" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <EntryProject ParameterType="System.String" Required="true" />
      <WalkCap ParameterType="System.Int32" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(MSBuildToolsPath)/Microsoft.Build.dll" />
      <Using Namespace="Microsoft.Build.Evaluation" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Same evaluated ProjectReference walk as the single-project CLI probe, without starting
        // an SDK process per dependency. Loading projects does not execute their build targets.
        var properties = new Dictionary<string, string>(((IBuildEngine6)BuildEngine).GetGlobalProperties(),
            StringComparer.OrdinalIgnoreCase);
        properties.Remove("CheckpointGraphEntry");
        properties.Remove("CheckpointGraphWalkCap");
        using (var projects = new ProjectCollection(properties))
        {
            var comparer = Path.DirectorySeparatorChar == '\\' ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;
            var pending = new Queue<string>();
            var seen = new HashSet<string>(comparer);
            pending.Enqueue(EntryProject);
            while (pending.Count != 0)
            {
                var path = pending.Dequeue();
                if (!seen.Add(path))
                    continue;
                if (seen.Count > WalkCap)
                {
                    Log.LogError("walk cap exceeded");
                    return false;
                }
                if (!File.Exists(path))
                {
                    Log.LogError("referenced project missing: " + path);
                    return false;
                }
                foreach (var reference in projects.LoadProject(path).GetItems("ProjectReference"))
                    pending.Enqueue(reference.GetMetadataValue("FullPath"));
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="Validate">
    <WalkCheckpointGraph EntryProject="$(CheckpointGraphEntry)" WalkCap="$(CheckpointGraphWalkCap)" />
  </Target>
</Project>
