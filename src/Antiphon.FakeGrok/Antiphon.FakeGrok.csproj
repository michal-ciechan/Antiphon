<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antiphon.FakeGrok</RootNamespace>
    <!-- Emits fakegrok.exe — the value used as an agent definition's Exe so it flows through the
         exact same RunnerGrokAdapter + session-runner path as the real `grok` CLI. -->
    <AssemblyName>fakegrok</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Antiphon.Agents.Pty.Tests" />
  </ItemGroup>

</Project>
