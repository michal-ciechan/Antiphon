<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antiphon.SessionRunner</RootNamespace>
    <AssemblyName>Antiphon.SessionRunner</AssemblyName>

    <!--
      Sdk.Web defaults to server GC: one heap per core (8 here), collected rarely, and slow to
      hand memory back. This daemon is I/O-bound plumbing, not a throughput server - it proxies
      pty bytes for a handful of sessions. Server GC cost it several GB of committed memory and
      made gen2 (and therefore LOH) collections almost never run. Workstation GC suits the shape
      of the work and releases promptly.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Antiphon.SessionRunner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Antiphon.Agents.Pty\Antiphon.Agents.Pty.csproj" />
    <ProjectReference Include="..\Antiphon.SessionRunner.Contracts\Antiphon.SessionRunner.Contracts.csproj" />
    <!-- The pty-host ships inside the runner's output; hosts are shadow-copied from there at launch. -->
    <ProjectReference Include="..\Antiphon.PtyHost\Antiphon.PtyHost.csproj" />
    <ProjectReference Include="..\Antiphon.PtyHost.Client\Antiphon.PtyHost.Client.csproj" />
  </ItemGroup>

</Project>
