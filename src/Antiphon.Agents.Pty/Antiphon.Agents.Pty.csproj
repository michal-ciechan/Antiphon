<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antiphon.Agents.Pty</RootNamespace>
    <AssemblyName>Antiphon.Agents.Pty</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
    <!-- The redistributable pseudoconsole (CARD-0037), consumed as a FILE SOURCE only: we load
         CreatePseudoConsole out of its conpty.dll ourselves (ModernConPtyConnection), so none of the
         package's own assets or MSBuild targets are wanted - those key off $(PlatformTarget) and
         stage OpenConsole.exe into an arch subdirectory, which is not the layout we ship.
         Provenance and the pinned hashes live in ConPtyRedistributable. -->
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001"
                      GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!-- Staged as Content so the pair FLOWS to every referencing project's output - the pty-host, the
       session runner, the server and the test assemblies all need it beside them, and each of them
       resolves it relative to its own AppContext.BaseDirectory.
       conpty.dll and OpenConsole.exe sit side by side: this conpty.dll accepts either that or an
       x64\ subdirectory and prefers the sibling when both exist (measured), and a missing
       OpenConsole.exe would make it fall back to the inbox conhost - silently undoing the fix. -->
  <ItemGroup Condition="'$(PkgMicrosoft_Windows_Console_ConPTY)' != ''">
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-x64\native\conpty.dll"
             Link="conpty\win-x64\conpty.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe"
             Link="conpty\win-x64\OpenConsole.exe"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Antiphon.Agents.Pty.Tests" />
  </ItemGroup>

</Project>
