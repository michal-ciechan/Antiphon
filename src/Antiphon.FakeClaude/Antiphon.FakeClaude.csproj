<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antiphon.FakeClaude</RootNamespace>
    <!-- Emits fakeclaude.exe — the value used as an agent definition's Exe so it flows through the
         exact same RunnerClaudeAdapter + session-runner path as the real `claude` CLI. -->
    <AssemblyName>fakeclaude</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- StdinClipModel's arithmetic (UTF-8 byte chunking, whole-chunk survival, seeded replay) is
         unit-tested directly: ConPTY narrows non-ASCII input to one byte per char before a .NET
         peer reads it, so a multibyte body cannot exercise the byte-vs-char rule through the pty. -->
    <InternalsVisibleTo Include="Antiphon.Agents.Pty.Tests" />
  </ItemGroup>

</Project>
