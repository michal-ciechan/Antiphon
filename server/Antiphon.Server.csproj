<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antiphon.Server</RootNamespace>
    <UserSecretsId>antiphon-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../scripts/lib/BuildDriverEnvironment.cs" Link="Infrastructure/BuildDriverEnvironment.cs" />
    <InternalsVisibleTo Include="Antiphon.Tests" />
    <InternalsVisibleTo Include="Antiphon.E2E" />
    <InternalsVisibleTo Include="Antiphon.ChannelOutbound.Probe" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Instruction bundles (CARD-0058): markdown in the repo, compiled in, loaded by
      InstructionBundles from the assembly manifest. Embedded rather than copied to the output so a
      bundle can never go missing from a deployment or be hand-edited beside a running server —
      changing one is a PR, which is the point. README.md is documentation FOR the bundles, not one
      of them; InstructionBundleTests pins the key set so an accidental inclusion fails a test
      rather than reaching an agent's system prompt.
    -->
    <EmbeddedResource Include="Bundles\*.md" Exclude="Bundles\README.md" />
    <!-- CARD-0032: preset prompt templates. Not attachable bundles — InstructionBundles skips the
         Presets. prefix so they cannot ride an agent's composition by accident. -->
    <EmbeddedResource Include="Bundles\Presets\*.md" />
    <!-- CARD-1213: shared fragments a bundle pulls in with {{NAME}}. Not bundles: InstructionBundles
         skips the Fragments. prefix and InstructionFragments loads them. -->
    <EmbeddedResource Include="Bundles\Fragments\*.md" />
    <!-- CARD-1385: land-graph digest. Outside the Bundles prefix, so InstructionBundles ignores it. -->
    <None Remove="Application\Services\LandVerificationBuildGraph.manifest.txt" />
    <EmbeddedResource Include="Application\Services\LandVerificationBuildGraph.manifest.txt">
      <LogicalName>Antiphon.Server.LandVerificationBuildGraph.manifest.txt</LogicalName>
    </EmbeddedResource>
    <!-- CARD-0306: per-launch remoteControlAtStartup:false overlay. Path, never inline JSON.
         Update, not Include: the SDK already globs this as Content. TargetPath flattens it
         next to the assembly so ApplyOff can resolve AppContext.BaseDirectory + filename. -->
    <Content Update="Runtime\claude-remote-control-off.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>claude-remote-control-off.json</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.4.1" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.5" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.IO.Abstractions" Version="22.1.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Confluent.Kafka" Version="2.6.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageReference Include="System.Management" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Antiphon.Agents.Pty\Antiphon.Agents.Pty.csproj" />
    <ProjectReference Include="..\src\Antiphon.Messaging\Antiphon.Messaging.csproj" />
    <ProjectReference Include="..\src\Antiphon.Messaging.Client\Antiphon.Messaging.Client.csproj" />
    <ProjectReference Include="..\src\Antiphon.SessionRunner.Contracts\Antiphon.SessionRunner.Contracts.csproj" />
    <ProjectReference Include="..\src\Antiphon.Resilience\Antiphon.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../scripts/lib/DiagnosticTextRedactor.cs" Link="Diagnostics/DiagnosticTextRedactor.cs" />
    <Compile Include="../scripts/lib/DiagnosticCredentialRedactor.cs" Link="Diagnostics/DiagnosticCredentialRedactor.cs" />
    <Compile Include="../scripts/lib/DiagnosticUrlRedactor.cs" Link="Diagnostics/DiagnosticUrlRedactor.cs" />
  </ItemGroup>
</Project>
