{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=17280;Database=antiphon;Username=antiphon;Password=antiphon_dev"
  },
  "Git": {
    "MaxConcurrentProcesses": 8,
    "TimeoutSeconds": 15,
    "ExecutableName": "git",
    "WorkspacePath": "",
    "DefaultBranch": "master",
    "PollIntervalSeconds": 30,
    "WorktreeBasePath": "C:\\Antiphon\\worktrees",
    "WorktreeStaleAfterDays": 7,
    "WorktreeJanitorIntervalHours": 24,
    "WorktreeAddTimeoutSeconds": 180,
    "WorktreeRemoveTimeoutSeconds": 300
  },
  "Projects": {
    "ReadinessCacheSeconds": 60
  },
  "Llm": {
    "DefaultProvider": "openai",
    "DefaultModel": "claude-sonnet-4-6",
    "Providers": {
      "openai": {
        "ApiKey": "",
        "BaseUrl": "https://api.openai.com",
        "Models": ["gpt-5.2", "gpt-4o", "gpt-4o-mini", "o3", "o4-mini"]
      },
      "anthropic": {
        "ApiKey": "",
        "BaseUrl": "https://api.anthropic.com",
        "Models": ["claude-opus-4-6", "claude-sonnet-4-6", "claude-haiku-4-5-20251001"]
      }
    }
  },
  "SignalR": {
    "HubPath": "/hubs/workflow",
    "ReconnectIntervalsMs": [0, 2000, 5000, 10000, 30000],
    "KeepAliveIntervalSeconds": 15,
    "ClientTimeoutSeconds": 30
  },
  "Audit": {
    "RetentionDays": 90,
    "EnableFullContent": true,
    "EnableIpLogging": true
  },
  "GitHub": {
    "Enabled": false,
    "PersonalAccessToken": "",
    "BaseUrl": "https://api.github.com"
  },
  "Deliverables": {
    "Enabled": true,
    "BrowserPath": null,
    "RenderTimeoutSeconds": 20,
    "MaxSourceFilesInline": 5,
    "MaxDocuments": 40
  },
  "SessionRunner": {
    "BaseUrl": "http://localhost:17204",
    "Enabled": true,
    "EventReconnectDelayMs": 1000,
    "RequestTimeoutSeconds": 100,
    "ListTimeoutSeconds": 3,
    "EventStreamIdleTimeoutSeconds": 90
  },
  "Agents": {
    "DefaultDefinition": "claude",
    "Definitions": {
      "claude": {
        "Kind": "ClaudeCode",
        "Exe": "claude.exe",
        "ArgsTemplate": ["--dangerously-skip-permissions"],
        "Env": {}
      },
      "codex": {
        "Kind": "Codex",
        "Exe": "codex.cmd",
        "ArgsTemplate": ["--no-alt-screen", "--dangerously-bypass-approvals-and-sandbox"],
        "Env": {}
      },
      "raw-pwsh": {
        "Kind": "Raw",
        "Exe": "pwsh.exe",
        "ArgsTemplate": ["-NoLogo", "-NoProfile"],
        "Env": {}
      },
      "grok": {
        "Kind": "Grok",
        "Exe": "grok.exe",
        "ArgsTemplate": ["--always-approve", "--no-alt-screen"],
        "Env": {}
      }
    },
    "ClaudeReadyQuietPeriodMs": 5000,
    "ClaudeReadyMaxWaitMs": 60000,
    "ClaudeDoneMaxWaitMs": 300000,
    "CodexReadyQuietPeriodMs": 1000,
    "CodexReadyMaxWaitMs": 60000,
    "CodexDoneQuietPeriodMs": 3000,
    "CodexDoneMaxWaitMs": 300000,
    "GrokReadyQuietPeriodMs": 1000,
    "GrokReadyMaxWaitMs": 60000,
    "GrokReadyMinTotalWaitMs": 2000,
    "GrokDoneQuietPeriodMs": 3000,
    "GrokDoneMaxWaitMs": 300000
  },
  "AgentSessions": {
    "SessionLogPath": "logs/sessions"
  },
  "AgentTui": {
    "ProbeTimeoutSeconds": 30,
    "MaxProbeOutputBytes": 65536,
    "KeyRingPath": "",
    "KeyProtection": {
      "Mode": "Auto",
      "CertificatePath": "",
      "CertificatePrivateKeyPath": "",
      "CertificateThumbprint": "",
      "CertificateStoreName": "My",
      "CertificateStoreLocation": "CurrentUser"
    }
  },
  "SessionReconciliation": {
    "Enabled": true,
    "IntervalMs": 15000,
    "StartingGraceMs": 90000,
    "AgentGraceMs": 120000
  },
  "Hangfire": {
    "ServerEnabled": true,
    "HistoryRetentionDays": 8
  },
  "ZombieCensus": {
    "Enabled": true,
    "RecurringJobId": "antiphon:zombie-census",
    "Cron": "30 9 * * *",
    "TimeZoneId": "Europe/London",
    "MinDoneMinutes": 120,
    "QuietHours": 6,
    "PidReuseToleranceSeconds": 5,
    "SessionLogPath": "C:\\logs\\antiphon\\session-runner"
  },
  "CardTransitions": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "StaleAfterDays": 7
  },
  "CardFileSync": {
    "Enabled": true,
    "AutoCommit": false,
    "IntervalSeconds": 60
  },
  "Supervision": {
    "ApiErrorRecovery": {
      "ModelCapFallbackHoldHours": 6
    }
  },

  "ParkedMessages": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "MinParkedMinutes": 10,
    "DryRun": false
  },
  "ContextWindow": {
    "DefaultContextTokens": 200000,
    "ModelOverrides": {}
  },
  "Cards": {
    "SummaryPreviewChars": 200,
    "MaxListResults": 500
  },
  "Retention": {
    "TranscriptRetentionDays": 30,
    "QueuedMessageRetentionDays": 30,
    "SessionRetentionDays": 90,
    "TaskRetentionDays": 180,
    "SweepHours": 6
  },
  "ContextCompaction": {
    "Enabled": true,
    "IdleMinutes": 480,
    "ContextPercent": 50,
    "CooldownHours": 24,
    "BoundaryTimeoutMinutes": 10
  },
  "Delegation": {
    "MaxCostUsdPerRoot": 200.00,
    "DefaultWindowDays": 7,
    "LandSweepSeconds": 5,
    "LandMaxAttempts": 3,
    "CheckInterpreterWorkingDirectory": "C:\\logs\\antiphon\\check-interpreter",
    "LlmEnvInheritance": {
      "Enabled": true,
      "Names": [
        "X_LLM_PROJECT",
        "X_LLM_KEY",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_CUSTOM_HEADERS",
        "GROK_BASE_URL",
        "GROK_CLI_CHAT_PROXY_BASE_URL",
        "GROK_XAI_API_BASE_URL",
        "OPENAI_BASE_URL",
        "OPENAI_API_KEY"
      ],
      "ProjectMarkerName": "X_LLM_PROJECT",
      "ProxyUrlNames": [
        "ANTHROPIC_BASE_URL",
        "GROK_BASE_URL",
        "GROK_CLI_CHAT_PROXY_BASE_URL",
        "GROK_XAI_API_BASE_URL",
        "OPENAI_BASE_URL"
      ],
      "ProxyHostMarkers": ["localhost", "127.0.0.1"],
      "RequireProjectAtProxy": true
    }
  },
  "ChannelBridge": {
    "Enabled": false,
    "AgentStartTimeoutSeconds": 90,
    "AgentReadyDelaySeconds": 12,
    "MaxReplyChars": 4000,
    "PendingReplyTtlMinutes": 30,
    "DebounceWindowMs": 500,
    "DebounceMaxMs": 2000,
    "BatchingEnabled": true
  },
  "Digest": {
    "Enabled": false,
    "SendTimesLocal": ["08:00", "18:00"],
    "TimeZone": "Europe/London",
    "WakeOnBlocked": true,
    "SweepSeconds": 60,
    "MaxChars": 3500,
    "RowsPerSection": 5
  },
  "Schedules": {
    "Enabled": true,
    "SweepSeconds": 5,
    "DefaultTimeZone": "Europe/London",
    "FireHistoryKeep": 50,
    "MaxPromptLength": 16000
  },
  "AntiphonMessaging": {
    "BootstrapServers": "localhost:19092",
    "InboundTopic": "channels.inbound",
    "OutboundTopic": "channels.outbound",
    "ConsumerGroup": "antiphon-server-bridge"
  },
  "Serilog": {
    "LogPath": "logs",
    "FileSizeLimitMb": 100,
    "RetainedFileCountLimit": 14,
    "RetainedFileTimeLimitDays": 5,
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Antiphon": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
