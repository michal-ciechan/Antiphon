# Runtime build context. The test image uses docker/tests/Dockerfile.dockerignore instead.
.git
**/.git
**/.gitignore
**/.antiphon
**/.grok
# CARD-0628 D-10: Claude state and credential files never enter a build context.
**/.claude
**/.credentials.json
**/.env
**/.env.*
client/.env*
**/*.pfx
**/*.pem
**/auth.json
**/node_modules
**/dist
**/.idea
**/.vs
**/obj
**/bin
**/bin-*
workspace
workspace/
logs
logs/
analysis/
tests/
*.md
*.ps1
.github/
server/appsettings.Development.json
# Embedded instruction bundles are markdown and must survive *.md.
!server/Bundles/
!server/Bundles/**
!server/Bundles/**/*.md
