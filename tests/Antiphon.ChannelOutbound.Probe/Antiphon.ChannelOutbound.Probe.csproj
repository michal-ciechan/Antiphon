<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The design-time and Roslyn packages below ship satellite resources for every culture; English only. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
    <!-- ProbeModelGenerator: scaffolds and compiles AppDbContext's compiled model from this build. Private, so its
         Roslyn 4.8 pins never reach Antiphon.Tests (which stages this probe and uses Roslyn 5.x itself). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20" PrivateAssets="all" />
    <ProjectReference Include="../../server/Antiphon.Server.csproj" />
  </ItemGroup>
  <!-- The test project stages this output directory with the probe. If baking fails,
       the test host's existing generator can still prepare the model under its seat. -->
  <Target Name="BakeVerifiedProbeModel" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --bake-model" Timeout="90000" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
