<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Antiphon.SessionRunner.Tests</RootNamespace>
    <AssemblyName>Antiphon.SessionRunner.Tests</AssemblyName>
    <EnableMicrosoftTestingPlatformRunner>true</EnableMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="TUnit" Version="1.44.0" />
    <PackageReference Include="Shouldly" Version="4.*" />
    <PackageReference Include="System.Management" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Antiphon.SessionRunner\Antiphon.SessionRunner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pinned compact-boundary shape lives beside its primary consumer (Antiphon.Tests);
         linked here so the tailer test drives the SAME line through the real tail loop. -->
    <Content Include="..\Antiphon.Tests\Agents\Fixtures\compact-boundary.jsonl"
             Link="Fixtures\compact-boundary.jsonl"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Real Codex rollouts captured 2026-08-20 (codex-cli 0.147.0) — see
         CodexTranscriptNormalizerTests for provenance and the one documented reduction. -->
    <Content Include="Fixtures\codex-*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <!-- CARD-0281 S0: measured Grok 402 pair + unverified 403 card wording. -->
    <Content Include="Fixtures\grok-*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
