<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Antiphon.SessionRunner.Tests</RootNamespace>
    <AssemblyName>Antiphon.SessionRunner.Tests</AssemblyName>
    <EnableMicrosoftTestingPlatformRunner>true</EnableMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="TUnit" Version="1.44.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="System.Management" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Antiphon.SessionRunner\Antiphon.SessionRunner.csproj" />
    <ProjectReference Include="..\Antiphon.CustodyTestChild\Antiphon.CustodyTestChild.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.FakeLlmApi\Antiphon.FakeLlmApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\NativeLinuxOnlyAttribute.cs" Link="TestSupport\NativeLinuxOnlyAttribute.cs" />
    <Compile Include="..\Shared\NativeLinuxPolicyWitness.cs" Link="TestSupport\NativeLinuxPolicyWitness.cs" />
    <Compile Include="..\Shared\NativeLinuxPolicyWitnessTests.cs" Link="TestSupport\NativeLinuxPolicyWitnessTests.cs" />
    <EmbeddedResource Include="..\Shared\NativeLinuxOnlyAttribute.cs">
      <LogicalName>Antiphon.TestSupport.NativeLinuxOnlyAttribute.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Shared\NativeLinuxWindowsBaseline.json">
      <LogicalName>Antiphon.TestSupport.NativeLinuxWindowsBaseline.json</LogicalName>
    </EmbeddedResource>
    <Compile Include="..\Shared\TestClassificationMetadata.cs" Link="TestSupport\TestClassificationMetadata.cs" />
    <Compile Include="..\Shared\TestClassificationGuardTests.cs" Link="TestSupport\TestClassificationGuardTests.cs" />
    <Compile Include="..\Shared\HerdrTestProcess.cs" Link="TestSupport\HerdrTestProcess.cs" />
    <Compile Include="..\Shared\ReadOnlyDirectory.cs" Link="TestSupport\ReadOnlyDirectory.cs" />
    <Compile Include="..\Shared\TestTiming.cs" Link="TestSupport\TestTiming.cs" />
    <Compile Include="..\Antiphon.Tests\TestHelpers\TestOwnedPtyHost.cs" Link="TestSupport\TestOwnedPtyHost.cs" />
    <None Include="slow-tests-allowlist.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCustodyChild" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Antiphon.CustodyTestChild\Antiphon.CustodyTestChild.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_CustodyChildTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_CustodyChildOutputDir>@(_CustodyChildTargetPath->'%(RootDir)%(Directory)')</_CustodyChildOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <CustodyChildOutput Include="$(_CustodyChildOutputDir)*" />
    </ItemGroup>
    <Copy SourceFiles="@(CustodyChildOutput)" DestinationFolder="$(OutDir)custody-child/" />
  </Target>

  <ItemGroup>
    <!-- The pinned compact-boundary shape lives beside its primary consumer (Antiphon.Tests);
         linked here so the tailer test drives the SAME line through the real tail loop. -->
    <Content Include="..\Antiphon.Tests\Agents\Fixtures\compact-boundary.jsonl"
             Link="Fixtures\compact-boundary.jsonl"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Real Codex rollouts captured 2026-08-20 (codex-cli 0.147.0) — see
         CodexTranscriptNormalizerTests for provenance and the one documented reduction. -->
    <Content Include="Fixtures\codex-*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <!-- CARD-0281 S0: measured Grok 402 pair + unverified 403 card wording. -->
    <Content Include="Fixtures\grok-*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyOwnedPtyHostAppHostForHerdr" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.PtyHost\Antiphon.PtyHost.csproj"
             Targets="Restore" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.PtyHost\Antiphon.PtyHost.csproj"
             Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true;OutDir=$(TargetDir)ptyhost-native/" />
    <Copy SourceFiles="$(TargetDir)ptyhost-native/Antiphon.PtyHost"
          DestinationFiles="$(TargetDir)Antiphon.PtyHost" SkipUnchangedFiles="true" />
  </Target>

</Project>
