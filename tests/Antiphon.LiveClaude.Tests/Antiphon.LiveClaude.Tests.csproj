    <IsTestProject>true</IsTestProject>
    <RootNamespace>Antiphon.LiveClaude.Tests</RootNamespace>
    <AssemblyName>Antiphon.LiveClaude.Tests</AssemblyName>
    <EnableMicrosoftTestingPlatformRunner>true</EnableMicrosoftTestingPlatformRunner>
  </PropertyGroup>
