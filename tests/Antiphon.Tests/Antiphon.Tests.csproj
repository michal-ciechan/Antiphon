    <StagedHelper Include="$(MSBuildThisFileDirectory)..\Antiphon.ChannelOutbound.Probe\Antiphon.ChannelOutbound.Probe.csproj" Folder="channel-outbound-probe" Glob="**\*" />
    <StagedHelper Include="$(MSBuildThisFileDirectory)..\Antiphon.Checkpoints.LifecycleHost\Antiphon.Checkpoints.LifecycleHost.csproj" Folder="checkpoint-lifecycle-host" Glob="**\*" />
    <StagedHelper Include="$(MSBuildThisFileDirectory)..\Antiphon.Checkpoints.FilterHost\Antiphon.Checkpoints.FilterHost.csproj" Folder="checkpoint-filter-host" Glob="**\*" />
    <StagedHelper Include="$(MSBuildThisFileDirectory)..\Antiphon.Checkpoints.RepeatHost\Antiphon.Checkpoints.RepeatHost.csproj" Folder="checkpoint-repeat-host" Glob="**\*" />
    <StagedHelper Include="$(MSBuildThisFileDirectory)..\Antiphon.TestTiming.Probe\Antiphon.TestTiming.Probe.csproj" Folder="timing-probe" Glob="**\*" />
    <StagedHelper Include="$(MSBuildThisFileDirectory)..\..\src\Antiphon.FakeClaude\Antiphon.FakeClaude.csproj" Folder="fakeclaude" Glob="**\*" />
    <StagedHelper Include="$(MSBuildThisFileDirectory)..\..\src\Antiphon.FakeGrok\Antiphon.FakeGrok.csproj" Folder="fakegrok" Glob="**\*" />
    <StagedHelper Include="$(MSBuildThisFileDirectory)..\..\tools\Antiphon.LandGraphAudit\Antiphon.LandGraphAudit.csproj" Folder="land-graph-audit" Glob="**\*" HelperTargetFramework="net10.0" />
  </ItemGroup>

  <!-- Copies each helper from its producer's own output; artifacts and relative OutputPath builds
       give every project its own output. One absolute OutputPath (the checkpoint tool) makes the
       producer's output this OutDir, and copying it nested every earlier helper folder into the
       next (CARD-1238, 38 GB), so the helper is built into its folder instead.
       Guard: TestHelpers/BuildOutputNestingTests. -->
  <Target Name="CopyStagedHelpers" AfterTargets="Build" Outputs="%(StagedHelper.Identity)">
    <ItemGroup>
      <_StagedHelperTarget Remove="@(_StagedHelperTarget)" />
      <_StagedHelperFiles Remove="@(_StagedHelperFiles)" />
    </ItemGroup>
    <PropertyGroup>
      <_StagedHelperFramework>%(StagedHelper.HelperTargetFramework)</_StagedHelperFramework>
      <_StagedHelperFramework Condition="'$(_StagedHelperFramework)' == ''">$(TargetFramework)</_StagedHelperFramework>
    </PropertyGroup>
    <MSBuild Projects="@(StagedHelper)" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(_StagedHelperFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_StagedHelperTarget" />
    </MSBuild>
    <PropertyGroup>
      <_StagedHelperDir>@(_StagedHelperTarget->'%(RootDir)%(Directory)')</_StagedHelperDir>
      <_StagedHelperDest>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(OutDir), %(StagedHelper.Folder)))</_StagedHelperDest>
      <_StagedHelperGlob>%(StagedHelper.Glob)</_StagedHelperGlob>
      <_StagedHelperShared>false</_StagedHelperShared>
      <_StagedHelperShared Condition="'$([MSBuild]::NormalizeDirectory($(_StagedHelperDir)))' == '$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(OutDir)))'">true</_StagedHelperShared>
    </PropertyGroup>
    <MSBuild Condition="'$(_StagedHelperShared)' == 'true'" Projects="@(StagedHelper)" Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(_StagedHelperFramework);OutDir=$(_StagedHelperDest)" />
    <ItemGroup Condition="'$(_StagedHelperShared)' != 'true'">
      <_StagedHelperFiles Include="$(_StagedHelperDir)$(_StagedHelperGlob)" />
    </ItemGroup>
    <Copy SourceFiles="@(_StagedHelperFiles)"
          DestinationFiles="@(_StagedHelperFiles->'$(_StagedHelperDest)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

