<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Antiphon.Tests</RootNamespace>
    <EnableMicrosoftTestingPlatformRunner>true</EnableMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.5.0" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="22.1.0" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.15.0" />
    <PackageReference Include="TUnit" Version="1.44.0" />
    <PackageReference Include="Shouldly" Version="4.*" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.20" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.*" />
    <PackageReference Include="System.Management" Version="9.*" />
    <PackageReference Include="Testcontainers.Redpanda" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned real-Claude record shapes (captured by headed canaries; e.g. compact-boundary.jsonl). -->
    <Content Include="Agents\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Antiphon.Agents.Pty.Tests\Fixtures\CodexStartup\**\*"
             Link="Fixtures\CodexStartup\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Antiphon.Agents.Pty.Tests\CodexStartupFixtures.cs"
             Link="Agents\CodexStartupFixtures.cs" />
    <Content Include="..\Antiphon.SessionRunner.Tests\Fixtures\grok-transport-error.jsonl"
             Link="Fixtures\grok-transport-error.jsonl"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Antiphon.SessionRunner.Tests\Fixtures\grok-1.0.13-auto-compaction.jsonl"
             Link="Fixtures\grok-1.0.13-auto-compaction.jsonl"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- CARD-0186 S4: the named-pipe herdr fake lives with the runner tests; compile it here so
         DirectSessionRunnerClient can talk to it without a test-project reference. -->
    <Compile Include="..\Antiphon.SessionRunner.Tests\FakeHerdrServer.cs"
             Link="TestHelpers\FakeHerdrServer.cs" />
    <Compile Include="..\Antiphon.SessionRunner.Tests\FakeHerdrTransport.cs"
             Link="TestHelpers\FakeHerdrTransport.cs" />
    <Compile Include="..\Shared\HerdrTestProcess.cs" Link="TestHelpers\HerdrTestProcess.cs" />
    <Compile Include="..\Antiphon.SessionRunner.Tests\LocalHttpRunner.cs"
             Link="TestHelpers\LocalHttpRunner.cs" />
    <Compile Include="..\Antiphon.SessionRunner.Tests\HerdrPaneDisposalFixture.cs"
             Link="TestHelpers\HerdrPaneDisposalFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\server\Antiphon.Server.csproj" Aliases="global,server" />
    <ProjectReference Include="..\..\src\Antiphon.Resilience\Antiphon.Resilience.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.HostCleanup\Antiphon.HostCleanup.csproj" />
    <ProjectReference Include="..\Antiphon.DockerStack.Fixture\Antiphon.DockerStack.Fixture.csproj" />
    <ProjectReference Include="..\Antiphon.CustodyTestChild\Antiphon.CustodyTestChild.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Antiphon.ChannelOutbound.Probe\Antiphon.ChannelOutbound.Probe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Antiphon.SessionRunner\Antiphon.SessionRunner.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.FakeLlmApi\Antiphon.FakeLlmApi.csproj" />
    <!-- CARD-0545: the independent nightly watchdog runs in-process against fakes at its four boundaries. -->
    <ProjectReference Include="..\..\src\Antiphon.NightlyWatchdog\Antiphon.NightlyWatchdog.csproj" />
    <ProjectReference Include="..\..\tools\Antiphon.Checkpoints\Antiphon.Checkpoints.csproj" />
    <ProjectReference Include="..\Antiphon.Checkpoints.LifecycleHost\Antiphon.Checkpoints.LifecycleHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Antiphon.Checkpoints.FilterHost\Antiphon.Checkpoints.FilterHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Antiphon.Messaging.Client.Testing\Antiphon.Messaging.Client.Testing.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.Messaging.Gateway\Antiphon.Messaging.Gateway.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.Messaging.Slack\Antiphon.Messaging.Slack.csproj" />
    <!-- Build the fake Claude (don't reference its assembly) so the end-to-end queue->PTY test can exec it. -->
    <ProjectReference Include="..\..\src\Antiphon.FakeClaude\Antiphon.FakeClaude.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Antiphon.FakeGrok\Antiphon.FakeGrok.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyCustodyChild" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Antiphon.CustodyTestChild\Antiphon.CustodyTestChild.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_CustodyChildTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_CustodyChildOutputDir>@(_CustodyChildTargetPath->'%(RootDir)%(Directory)')</_CustodyChildOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <CustodyChildOutput Include="$(_CustodyChildOutputDir)*" />
    </ItemGroup>
    <Copy SourceFiles="@(CustodyChildOutput)" DestinationFolder="$(OutDir)custody-child/" />
  </Target>

  <Target Name="CopyChannelOutboundProbe" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Antiphon.ChannelOutbound.Probe\Antiphon.ChannelOutbound.Probe.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_ChannelOutboundProbeTarget" />
    </MSBuild>
    <PropertyGroup><_ChannelOutboundProbeDir>@(_ChannelOutboundProbeTarget->'%(RootDir)%(Directory)')</_ChannelOutboundProbeDir></PropertyGroup>
    <ItemGroup><ChannelOutboundProbeOutput Include="$(_ChannelOutboundProbeDir)**\*" /></ItemGroup>
    <Copy SourceFiles="@(ChannelOutboundProbeOutput)"
          DestinationFiles="@(ChannelOutboundProbeOutput->'$(OutDir)channel-outbound-probe\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCheckpointProbeHosts" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Antiphon.Checkpoints.LifecycleHost\Antiphon.Checkpoints.LifecycleHost.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_LifecycleHostTarget" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Antiphon.Checkpoints.FilterHost\Antiphon.Checkpoints.FilterHost.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_FilterHostTarget" />
    </MSBuild>
    <PropertyGroup>
      <_LifecycleHostDir>@(_LifecycleHostTarget->'%(RootDir)%(Directory)')</_LifecycleHostDir>
      <_FilterHostDir>@(_FilterHostTarget->'%(RootDir)%(Directory)')</_FilterHostDir>
    </PropertyGroup>
    <ItemGroup>
      <_LifecycleHostFiles Include="$(_LifecycleHostDir)**\*" />
      <_FilterHostFiles Include="$(_FilterHostDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LifecycleHostFiles)"
          DestinationFiles="@(_LifecycleHostFiles->'$(OutDir)checkpoint-lifecycle-host/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_FilterHostFiles)"
          DestinationFiles="@(_FilterHostFiles->'$(OutDir)checkpoint-filter-host/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyFakeClaude" AfterTargets="Build">
    <!-- Query each producer's output: artifacts builds have project-specific absolute paths,
         while normal and alternate OutputPath builds use paths relative to each project. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.FakeClaude\Antiphon.FakeClaude.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_FakeClaudeTargetPath" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.FakeGrok\Antiphon.FakeGrok.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_FakeGrokTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_FakeClaudeOutputDir>@(_FakeClaudeTargetPath->'%(RootDir)%(Directory)')</_FakeClaudeOutputDir>
      <_FakeGrokOutputDir>@(_FakeGrokTargetPath->'%(RootDir)%(Directory)')</_FakeGrokOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <FakeClaudeOutput Include="$(_FakeClaudeOutputDir)**\*" />
      <FakeGrokOutput Include="$(_FakeGrokOutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeClaudeOutput)"
          DestinationFiles="@(FakeClaudeOutput->'$(OutDir)fakeclaude\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FakeGrokOutput)"
          DestinationFiles="@(FakeGrokOutput->'$(OutDir)fakegrok\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Compile Include="../Antiphon.Agents.Pty.Tests/EffortTestScreen.cs" Link="Agents/EffortTestScreen.cs" />
    <Compile Include="../Antiphon.Messaging.Tests/KestrelLoopback.cs" Link="TestHelpers/KestrelLoopback.cs" />
    <Compile Include="../Antiphon.Messaging.Tests/FakeSlack/FakeSlackServer.cs" Link="TestHelpers/FakeSlackServer.cs" />
    <Compile Include="..\Shared\TestClassificationMetadata.cs" Link="TestSupport\TestClassificationMetadata.cs" />
    <Compile Include="..\Shared\ProgressAwareWait.cs" Link="TestSupport\ProgressAwareWait.cs" />
    <Compile Include="..\Shared\TestAppHostPath.cs" Link="TestSupport\TestAppHostPath.cs" />
    <Compile Include="..\Shared\TestClassificationGuardTests.cs" Link="TestSupport\TestClassificationGuardTests.cs" />
    <None Include="slow-tests-allowlist.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../docs/superpowers/plans/2026-09-08-card-0449-claude-effort-dialog-captures.json" LogicalName="Card0449.EffortCaptures.json" />
  </ItemGroup>
  <!-- The detached pty-host relaunches Environment.ProcessPath. Build its real
       native apphost even when a Linux checkpoint uses UseAppHost=false. -->
  <Target Name="CopyOwnedPtyHostAppHost" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <PropertyGroup><_PtyHostNativeDir>$(TargetDir)ptyhost-native/</_PtyHostNativeDir></PropertyGroup>
    <!-- The outer Linux build restores with UseAppHost=false, which omits the net9
         apphost pack. Restore this producer with the same property as its inner build. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.PtyHost\Antiphon.PtyHost.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.PtyHost\Antiphon.PtyHost.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true;OutDir=$(_PtyHostNativeDir)" />
    <Copy SourceFiles="$(_PtyHostNativeDir)Antiphon.PtyHost"
          DestinationFiles="$(TargetDir)Antiphon.PtyHost" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyOwnedHerdrFakeAppHosts" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.FakeClaude\Antiphon.FakeClaude.csproj"
             Targets="Restore" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.FakeClaude\Antiphon.FakeClaude.csproj"
             Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true;OutDir=$(TargetDir)fake-native-claude/" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.FakeGrok\Antiphon.FakeGrok.csproj"
             Targets="Restore" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.FakeGrok\Antiphon.FakeGrok.csproj"
             Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true;OutDir=$(TargetDir)fake-native-grok/" />
    <Copy SourceFiles="$(TargetDir)fake-native-claude/fakeclaude"
          DestinationFiles="$(TargetDir)fakeclaude/fakeclaude" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)fake-native-grok/fakegrok"
          DestinationFiles="$(TargetDir)fakegrok/fakegrok" SkipUnchangedFiles="true" />
  </Target>
</Project>
