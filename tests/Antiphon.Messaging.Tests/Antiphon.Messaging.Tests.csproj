<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Antiphon.Messaging.Tests</RootNamespace>
    <EnableMicrosoftTestingPlatformRunner>true</EnableMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.44.0" />
    <PackageReference Include="Shouldly" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.*" />
    <PackageReference Include="Confluent.Kafka" Version="2.6.0" />
    <!-- Self-host FakeTelegramServer / FakeSlackServer (Kestrel + minimal API + WebSockets). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Antiphon.Messaging\Antiphon.Messaging.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.Messaging.Telegram\Antiphon.Messaging.Telegram.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.Messaging.Slack\Antiphon.Messaging.Slack.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.Messaging.Client\Antiphon.Messaging.Client.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.Messaging.Client.Testing\Antiphon.Messaging.Client.Testing.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.Messaging.Gateway\Antiphon.Messaging.Gateway.csproj" />
    <ProjectReference Include="..\..\tools\Antiphon.Messaging.SchemaGen\Antiphon.Messaging.SchemaGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
