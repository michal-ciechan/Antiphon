<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Antiphon.Agents.Pty.Tests</RootNamespace>
    <AssemblyName>Antiphon.Agents.Pty.Tests</AssemblyName>
    <EnableMicrosoftTestingPlatformRunner>true</EnableMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="TUnit" Version="1.44.0" />
    <PackageReference Include="Shouldly" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden recordings of REAL Claude PTY bytes — replayed to pin our parsers/detectors/screen
         reconstruction against ground truth. Copied verbatim to the test output. -->
    <Content Include="golden\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Node peers for the pty input path. The real Claude is Node, so a .NET peer cannot
         characterise the consumer that actually loses bytes (CARD-0027). -->
    <Content Include="probes\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Antiphon.Agents.Pty\Antiphon.Agents.Pty.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.SessionRunner.Contracts\Antiphon.SessionRunner.Contracts.csproj" />
    <!-- Referenced two ways on purpose: the CopyFakeClaude target below stages its FULL output
         (exe + runtimeconfig + deps) into bin\...\fakeclaude\ so tests can exec it through ConPTY,
         and the assembly reference lets StdinClipModelTests unit-test the clip arithmetic directly
         (InternalsVisibleTo) — the pty cannot carry a multibyte body, so it cannot test that. -->
    <ProjectReference Include="..\..\src\Antiphon.FakeClaude\Antiphon.FakeClaude.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.FakeGrok\Antiphon.FakeGrok.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.FakeLlmApi\Antiphon.FakeLlmApi.csproj" />
  </ItemGroup>

  <Target Name="CopyFakeClaude" AfterTargets="Build">
    <ItemGroup>
      <!-- $(OutputPath), not a hardcoded bin\$(Configuration)\net9.0: builds here routinely pass
           the OutputPath=bin-fake/ property because the always-on daemons lock bin\, and that global
           property reaches the referenced FakeClaude project too — so its output lands at the SAME
           relative path under its own directory. Globbing the hardcoded path staged a STALE
           fakeclaude.exe, or (in a fresh worktree) none at all, which silently SKIPPED every test
           that needs it. -->
      <FakeClaudeOutput Include="..\..\src\Antiphon.FakeClaude\$(OutputPath)**\*" />
      <FakeGrokOutput Include="..\..\src\Antiphon.FakeGrok\$(OutputPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeClaudeOutput)"
          DestinationFiles="@(FakeClaudeOutput->'$(OutDir)fakeclaude\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FakeGrokOutput)"
          DestinationFiles="@(FakeGrokOutput->'$(OutDir)fakegrok\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
