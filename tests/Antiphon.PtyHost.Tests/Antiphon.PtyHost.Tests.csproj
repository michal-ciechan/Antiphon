<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Antiphon.PtyHost.Tests</RootNamespace>
    <AssemblyName>Antiphon.PtyHost.Tests</AssemblyName>
    <EnableMicrosoftTestingPlatformRunner>true</EnableMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.44.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Antiphon.PtyHost\Antiphon.PtyHost.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.PtyHost.Client\Antiphon.PtyHost.Client.csproj" />
    <ProjectReference Include="..\..\src\Antiphon.PtyHost.Protocol\Antiphon.PtyHost.Protocol.csproj" />
    <ProjectReference Include="..\Antiphon.Card0490.NativeHarness\Antiphon.Card0490.NativeHarness.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TestClassificationMetadata.cs" Link="TestSupport\TestClassificationMetadata.cs" />
    <Compile Include="..\Shared\TestClassificationGuardTests.cs" Link="TestSupport\TestClassificationGuardTests.cs" />
    <None Include="slow-tests-allowlist.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Outer checkpoints keep UseAppHost=false. This target restores the linux-x64
       apphost and libporta_pty.so into an isolated subdirectory of TargetDir. -->
  <Target Name="CopyOwnedPtyHostAppHost" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <PropertyGroup>
      <_PtyHostNativeDir>$(TargetDir)ptyhost-native/</_PtyHostNativeDir>
      <_PtyHostNativeProps>Configuration=$(Configuration);TargetFramework=$(TargetFramework);UseAppHost=true;RuntimeIdentifier=linux-x64;SelfContained=false;OutDir=$(_PtyHostNativeDir)</_PtyHostNativeProps>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.PtyHost\Antiphon.PtyHost.csproj"
             Targets="Restore"
             Properties="$(_PtyHostNativeProps)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\src\Antiphon.PtyHost\Antiphon.PtyHost.csproj"
             Targets="Build"
             Properties="$(_PtyHostNativeProps)" />
    <Copy SourceFiles="$(_PtyHostNativeDir)Antiphon.PtyHost"
          DestinationFiles="$(TargetDir)Antiphon.PtyHost" />
    <Copy SourceFiles="$(_PtyHostNativeDir)libporta_pty.so"
          DestinationFiles="$(TargetDir)libporta_pty.so" />
    <Exec Command="chmod u+x &quot;$(TargetDir)Antiphon.PtyHost&quot;" />
  </Target>

</Project>
