# <remoteRoot>/env for the Antiphon nightly watchdog (systemd EnvironmentFile).
# Names only. The operator places values on the watchdog host; mode 0600, owner the service user.
# Never commit a filled copy. See docs/nightly-watchdog.md.

# Written by scripts/deploy-nightly-watchdog.ps1 from the deploy profile when absent:
ANTIPHON_WATCHDOG_SNAPSHOT_BIND=
ANTIPHON_WATCHDOG_STATE_DIR=./state
ANTIPHON_WATCHDOG_NAMESPACE=mc

# Placed by the operator:
ANTIPHON_WATCHDOG_WINDMILL_BASE_URL=
ANTIPHON_WATCHDOG_WINDMILL_TOKEN=
ANTIPHON_WATCHDOG_WINDMILL_WORKSPACE=mc
ANTIPHON_WATCHDOG_SCRIPT_PATH=u/lndcobra/antiphon_nightly_tests
ANTIPHON_WATCHDOG_SCHEDULE_PATH=u/lndcobra/antiphon_nightly_tests
ANTIPHON_WATCHDOG_EXPECTED_SCRIPT_HASH=
ANTIPHON_WATCHDOG_TELEGRAM_BOT_TOKEN=
ANTIPHON_WATCHDOG_DESTINATION_CHAT_ID=
ANTIPHON_WATCHDOG_READER_PEER=
ANTIPHON_WATCHDOG_READER_PEER_USERNAME=
ANTIPHON_WATCHDOG_TG_API_ID=
ANTIPHON_WATCHDOG_TG_API_HASH=
