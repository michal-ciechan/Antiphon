<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Antiphon.DerivedImpactIndex</RootNamespace>
    <AssemblyName>Antiphon.DerivedImpactIndex</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the same inputs as the drift witness without building the entire test,
         server and staged-helper graph just to regenerate a syntax-only index. -->
    <Compile Include="../../tests/Antiphon.Tests/Scripts/DerivedImpactIndexBuilder.cs" Link="DerivedImpactIndexBuilder.cs" />
    <Compile Include="../../tests/Antiphon.Tests/Scripts/ReleaseImpactGraphBuilder.cs" Link="ReleaseImpactGraphBuilder.cs" />
    <Compile Include="../../tests/Shared/PlatformTaxonomy.cs" Link="PlatformTaxonomy.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="TUnit.Core" Version="1.44.0" />
  </ItemGroup>
</Project>
