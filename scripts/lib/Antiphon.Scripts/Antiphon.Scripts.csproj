<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The scripts' command-line implementation (antiphon-scripts <command>). nightly-core.ps1 builds it once
    per source version into a cache under the user's temp directory and the PowerShell scripts run the
    built executable. Each command handles only what it can answer exactly as the PowerShell it replaces;
    anything else exits NotHandled and the caller keeps its PowerShell path. Pure .NET: no PowerShell.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Antiphon.Scripts</RootNamespace>
    <AssemblyName>Antiphon.Scripts</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CheckpointProcessRunner.cs" Link="CheckpointProcessRunner.cs" />
    <!-- The nightly-tests and build-slot commands prepare their children as Set-AntiphonBuildDriverEnvironment did (CARD-1506). -->
    <Compile Include="../BuildDriverEnvironment.cs" Link="BuildDriverEnvironment.cs" />
    <!-- build-slot gives a dotnet command on Linux a private TMPDIR for its lease, as build-slot.ps1 did (CARD-1981). -->
    <Compile Include="../LeaseTempDirectory.cs" Link="LeaseTempDirectory.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rc commands call the compiled core's plain C# (ledger, admission, plans); PowerShell is never loaded. -->
    <ProjectReference Include="../Antiphon.Nightly/Antiphon.Nightly.csproj" />
    <!-- The live lane's isolated project (W2 slice S21): its commands bind its seams here; it references nothing back. -->
    <ProjectReference Include="../Antiphon.LiveLane/Antiphon.LiveLane.csproj" />
  </ItemGroup>
</Project>
