<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The scripts' command-line implementation (antiphon-scripts <command>). nightly-core.ps1 builds it once
    per source version into a cache under the user's temp directory and the PowerShell scripts run the
    built executable. Each command handles only what it can answer exactly as the PowerShell it replaces;
    anything else exits NotHandled and the caller keeps its PowerShell path. Pure .NET: no PowerShell.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Antiphon.Scripts</RootNamespace>
    <AssemblyName>Antiphon.Scripts</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CheckpointProcessRunner.cs" Link="CheckpointProcessRunner.cs" />
  </ItemGroup>
</Project>
