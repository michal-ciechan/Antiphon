<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The nightly scripts' compiled implementation. nightly-core.ps1 builds this project once per source
    version into a cache under the user's temp directory and loads it into the PowerShell session; the
    tests reference it directly and call the parts that use plain C# types in-process.
    PowerShell's own System.Management.Automation is used at run time: the reference is compile-only.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Antiphon.Nightly</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" IncludeAssets="compile" PrivateAssets="all" />
    <ProjectReference Include="../../../src/Antiphon.IO.WriteBehind/Antiphon.IO.WriteBehind.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- CARD-1313: the selector identity (TestSelection.SelectorFiles). The running selector compares its own sources
         with the candidate's blobs, so they travel with the assembly. -->
    <EmbeddedResource Include="TestSelection.cs;TestSelectionCatalog.cs;TestSelectionGit.cs;TestSelectionJson.cs" LogicalName="selector/%(Filename)%(Extension)" />
    <!-- The impacted-classes selector identity (ImpactedClasses.SelectorFiles): the release evidence binds the running
         selector's own bytes to the source checkout's committed blobs. -->
    <EmbeddedResource Include="ImpactedClasses.cs;ImpactedClassesInputs.cs;ReleaseImpactEvidence.cs" LogicalName="impacted/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
