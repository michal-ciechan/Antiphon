<Project>
  <!--
    Keep MSBuild's default item globs (and NuGet restore's project evaluation) from crawling
    runtime/output directories that live inside project folders. The SDK only auto-excludes
    bin/ and obj/ — without this, the session-runner's workspace/ (session logs + pty-host
    shadow copies) and the alternate build outputs (bin-verify/, bin-ptyhost/, bin-<name>/, used
    to build while the daemons hold bin/ locked) get enumerated on EVERY evaluation. That once
    nested recursively (shadow copies swallowing sibling output dirs) and drove restore+build of
    Antiphon.SessionRunner past 10 minutes. A general bin-*/** glob replaces the four
    hand-maintained prefixes (bin-verify/**, bin-ptyhost/**, bin-profile*/**, bin-c37*/**) that
    used to live here — every delegate build picks its own bin-<task>/ name, and a name this list
    didn't happen to cover broke a build with MSB3030 (found 2026-08-21, CARD-0110).
  -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);workspace/**;bin-*/**</DefaultItemExcludes>
    <!--
      CARD-0179 R3: stamp the git SHA into AssemblyInformationalVersion at build time.
      SourceControlInformationFeatureSupported=true tells the SDK that a later target will
      supply SourceRevisionId (so it does not also try to probe git itself). The Exec
      below is best-effort: ContinueOnError + fallback "unknown" so a machine without git
      still builds. IncludeSourceRevisionInInformationalVersion is the SDK default (true).
    -->
    <SourceControlInformationFeatureSupported>true</SourceControlInformationFeatureSupported>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
  </PropertyGroup>

  <!--
    CARD-0795: an isolated build (OutputPath=bin-<name>/, the shape every delegate build,
    scripts/run-checkpoint.ps1, the checkpoint tool and build-slot.ps1 callers use) compiles each
    project in its own short-lived csc child of its MSBuild node instead of the one per-user shared
    VBCSCompiler, so concurrent builds stop sharing one unattributable compiler process and each
    compile dies with its build. bin/ builds (the daemons, restart-apphost.ps1), artifacts-path
    builds (the land verifier) and operator shells keep the SDK default. An explicit
    UseSharedCompilation (command line or environment) wins; deleting this group is the rollback.
    Owner: docs/testing-and-build.md "Build slots (CARD-0589)".
  -->
  <PropertyGroup>
    <AntiphonIsolatedOutput Condition="'$(AntiphonIsolatedOutput)' == '' and $([System.String]::Copy('$(OutputPath)').StartsWith('bin-'))">true</AntiphonIsolatedOutput>
    <UseSharedCompilation Condition="'$(UseSharedCompilation)' == '' and '$(AntiphonIsolatedOutput)' == 'true'">false</UseSharedCompilation>
  </PropertyGroup>

  <!--
    Runs before the SDK's empty InitializeSourceControlInformation target. WorkingDirectory
    is this file's directory (the repo root), not the project folder, so nested projects
    still stamp the same commit.
  -->
  <Target Name="SetSourceRevisionIdFromGit"
          BeforeTargets="InitializeSourceControlInformation"
          Condition="'$(SourceRevisionId)' == '' or '$(SourceRevisionId)' == 'unknown'">
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHeadSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitRevParseExitCode" />
    </Exec>
    <PropertyGroup>
      <_GitHeadShaTrimmed>$([System.String]::Copy('$(_GitHeadSha)').Trim())</_GitHeadShaTrimmed>
      <SourceRevisionId Condition="'$(_GitRevParseExitCode)' == '0' and '$(_GitHeadShaTrimmed)' != ''">$(_GitHeadShaTrimmed)</SourceRevisionId>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == '' or '$(SourceRevisionId)' == 'unknown'">unknown</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
