# Auto detect text files and perform LF normalization
* text=auto

# Preserve the byte hashes recorded by CARD-0395 native acceptance provenance.
tests/Antiphon.SessionRunner.Tests/Fixtures/grok-1.0.13-auto-compaction.jsonl text eol=lf
tests/Antiphon.Tests/Agents/Fixtures/grok-rules-live-inline-1.0.13.json text eol=lf

# CARD-0490 guest scripts: packaging must preserve LF working-file bytes.
tests/fixtures/card0490-linux/*.sh text eol=lf
docker/session-runner-grok/Dockerfile text eol=lf
docker-compose.runner-grok.yml text eol=lf

# CARD-0449 replay fixtures: real PTY byte streams. Any normalisation changes their pinned hashes.
tests/Antiphon.Agents.Pty.Tests/golden/card-0449/*.ansi -text

# CARD-0604: files the Linux runner parses byte-for-byte. A CRLF working copy on Windows reaches
# server2 through scp/COPY and puts a stray \r in every shell token, ssh keyword and git value.
scripts/*.sh text eol=lf
docker/session-runner-grok/dind-entrypoint.sh text eol=lf
docker/session-runner-grok/daemon.json text eol=lf
docker/session-runner-grok/ssh_config text eol=lf
docker/session-runner-grok/gitconfig text eol=lf
docker/session-runner-grok/github_known_hosts text eol=lf
docker/session-testing/*.sh text eol=lf
docker/stack/*.sh text eol=lf
docker-compose.server2-runner.yml text eol=lf
