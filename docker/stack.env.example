# Placeholders only. Do not put a real password, token, or certificate in this file.
POSTGRES_PASSWORD=change-me
SOURCE_REVISION=unknown
ANTIPHON_BIND_ADDRESS=127.0.0.1
ANTIPHON_BIND_PORT=5000
# CARD-0604: the persistent server2 runner deployment (docker-compose.server2-runner.yml).
COMPOSE_PROJECT_NAME=antiphon-runner
SOURCE_SHA12=unknown
PHONE_HOME_SERVER_ORIGIN=https://antiphon.desktop.codeperf.net
# Paths on the server2 host to the two secret files. The files themselves never leave server2.
ANTIPHON_DEPLOY_KEY_FILE=/home/mc/antiphon-server2/secrets/deploy_key
PHONE_HOME_SECRET_FILE=/home/mc/antiphon-server2/secrets/phone-home
# CARD-0628: the host path of the Claude setup-token FILE. deploy-parent writes it from the vault
# (0600, empty when the vault had nothing). The token itself never goes into this or any env file.
CLAUDE_OAUTH_TOKEN_FILE=/home/mc/antiphon-server2/secrets/claude_oauth_token
# CARD-0631: the host path of the runner's git identity file (non-secret). deploy-parent creates it
# from the two values below only when it is missing; an existing file is never overwritten.
RUNNER_GIT_IDENTITY_FILE=/home/mc/antiphon-server2/secrets/gitconfig
RUNNER_GIT_USER_NAME=antiphon-server2-runner
RUNNER_GIT_USER_EMAIL=antiphon-server2-runner@users.noreply.github.com
# CARD-0660: the host path of the runner's Codex home, a DIRECTORY (uid 1654, 0700) that holds the
# operator's ChatGPT sign-in. deploy-parent creates it empty when missing and never reads it; it is
# bind-mounted read-write at /state/codex (CODEX_HOME) in the runner and /codex-home in state-init.
RUNNER_CODEX_HOME_DIR=/home/mc/antiphon-server2/secrets/codex
