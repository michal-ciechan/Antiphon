# The review engine in Docker (docker-compose.review.yml). Copy this file to review.env at the repo
# root and fill it in. Placeholders only: never commit review.env (it is git- and docker-ignored).
# Guide: docs/features/012-review-engine/getting-started.md, section 6.3.
#
# One setting per line, KEY=value, no quotes needed. A setting's ':' is '__' here, and list items
# are numbered from 0 (Repos__0__Repo). Lines starting with # are ignored.

# --- The stack (read by compose) ------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Where the UI and API listen on this machine. Put a reverse proxy with TLS in front for other people.
REVIEW_BIND_ADDRESS=127.0.0.1
REVIEW_BIND_PORT=8080
# Optional knobs (defaults shown): reviewers at once, and the models of each kind of call.
# REVIEW_MAX_PARALLEL=2
# REVIEW_DEEP_MODEL=opus
# REVIEW_STANDARD_MODEL=sonnet
# REVIEW_CHEAP_MODEL=haiku

# --- Claude sign-in: uncomment ONE -------------------------------------------------------------
# A Claude subscription: run `claude setup-token` on any machine and paste the token here.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-xxxxxxxx
# Or an Anthropic API key (billed per token):
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# --- The UI's address -----------------------------------------------------------------------------
# GitHub statuses link to {PublicBaseUrl}/reviews/{runId}.
Review__PublicBaseUrl=http://localhost:8080

# --- The GitHub App (guide section 3) ------------------------------------------------------------
Review__CodeHosts__Hosts__github__Kind=GitHub
Review__CodeHosts__Hosts__github__App__AppId=Iv23xxxxxxxxxxxxxxxx
Review__CodeHosts__Hosts__github__App__InstallationId=12345678
# The App's .pem key on ONE line, each line break written as \n.
Review__Secrets__GitHubAppPrivateKey=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
# GitHub Enterprise Server: the API root.
# Review__CodeHosts__Hosts__github__BaseUrl=https://github.example.com/api/v3

# --- The repos to review (add __1__, __2__ ... for more) ---------------------------------------
Review__Polling__Enabled=true
Review__Polling__IntervalSeconds=120
Review__Polling__Repos__0__Repo=acme/widgets
# Only PRs with this label are reviewed. Remove the line to review every open PR.
Review__Polling__Repos__0__RequireLabel=antiphon

# --- Merging (guide section 7.4) -------------------------------------------------------------------
Review__Policy__MergeMethod=squash
# Merge approved PRs without a person confirming each one:
# Review__Policy__GatesOff__merge-gate__0=acme/widgets

# --- Who is acting (guide section 7.1) ---------------------------------------------------------------
# With sign-in off, everyone who opens the UI acts as this GitHub login.
Review__DefaultViewerLogin=your-github-login
# Let a PR's author decide its gates (for people who review their own PRs):
# Review__Policy__AuthorMayDecideRepos__0=acme/widgets

# --- Sign-in, section 7.1 ----------------------------------------------------------------------------
# None (default): no sign-in, everyone acts as Review__DefaultViewerLogin.
# GitHub: people sign in with GitHub through the App's OAuth client.
Review__Auth__Mode=None
# Review__Auth__ClientId=Iv23xxxxxxxxxxxxxxxx
# Review__Secrets__GitHubOAuthClientSecret=xxxxxxxx
# Review__Auth__AllowedLogins__0=your-github-login
