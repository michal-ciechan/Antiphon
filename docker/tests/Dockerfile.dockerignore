# Test-image context. Supersedes the root .dockerignore for docker/tests/Dockerfile.
.git
**/.git
**/.gitignore
**/.antiphon
**/.grok
# CARD-0628 D-10: Claude state and credential files never enter a build context.
**/.claude
# The Linux test lane inspects the repo's own skill docs; settings and credentials stay out.
!.claude/skills
!.claude/skills/**
**/.credentials.json
**/.env
**/.env.*
client/.env*
**/*.pfx
**/*.pem
**/auth.json
**/node_modules
**/dist
**/.idea
**/.vs
**/obj
**/bin
**/bin-*
workspace
workspace/
logs
logs/
analysis/
server/appsettings.Development.json
.github/
